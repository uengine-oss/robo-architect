# Debian 13(trixie). **12(bookworm)에서 올렸다 — 2026-10-16.**
#
# 이 이미지만 bookworm 이라 열한 개 중 가장 나빴다(치명 9·고위험 76, done12 §222).
# 베이스만 바꿔 재니 critical+high 가 **53 → 3** 이 된다
# (openssl 17·perl 9·gnutls28 8·util-linux 6·glibc 5 가 통째로 빠진다).
#
# 파이썬은 3.11 그대로다. OS 와 런타임을 같이 올리면 무엇이 깨졌는지 못 가린다.
FROM ghcr.io/astral-sh/uv:python3.11-trixie-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

# 취약점 보정 ⑥ (2026-10-19) — **setuptools 가 품고 있는 사본**을 올린다.
#
# 베이스의 setuptools 79.0.1 이 `_vendor/` 에 `jaraco.context-5.3.0` 과
# `wheel-0.45.1` 을 품고 있고, 둘 다 고위험이다.
#   CVE-2026-23949  jaraco.context.tarball() 의 압축 해제 경로 탈출  <6.1.0
#   CVE-2026-24049  wheel.unpack 의 chmod 경로 탈출                 <=0.46.1
# 우리 venv 는 이미 높은 판을 쓴다 — 이 둘은 **베이스 파이썬 쪽 사본**이라
# `pyproject.toml` 의 바닥이 닿지 않았다(그래서 §264 에서 ⑥ 으로 따로 떼어 뒀다).
#
# setuptools 84.0.0 이 `jaraco_context-6.1.0` · `wheel-0.46.3` 을 품는다(실측).
# 바닥만 적는다 — 판을 못 박으면 다음에 또 낡는다.
#
# ⚠ 둘 다 **빌드 시점 코드 경로**다(압축 해제). 이 이미지의 런타임은
# `uvicorn api.authority:app` 뿐이고 setuptools 를 부르지 않는다. 그래도 올린다 —
# **닿지 않는다는 설명보다 올리는 쪽이 싸다**(ISS-39 처럼 못 올리는 자리가 아니다).
RUN uv pip install --system --no-cache 'setuptools>=84.0.0'

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project

COPY api ./api
COPY scripts ./scripts
COPY templates ./templates

RUN python -c "import api.authority, scripts.accounts_admin"

EXPOSE 59020

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=12 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:59020/healthz', timeout=3).read()"

CMD ["python", "-m", "uvicorn", "api.authority:app", "--host", "0.0.0.0", "--port", "59020"]

