# Copy to central-authority.env on the DB server and fill every required value.
# Do not commit or distribute the completed file.

AUTH_PROVIDER=swp
AUTH_ENFORCE=true
AUTH_DEV_LOGIN_ENABLED=false
AUTH_JWT_SECRET=
AUTH_ROLE_SECRET=

# Limited central API role. Never use the PostgreSQL superuser here.
OG_PG_DSN=

# Separate server-only role used only for project create/share operations.
ROBO_PROJECT_OPERATOR_DSN=

# Origins the SSO callback may return to, comma separated.
# Leave empty and only loopback is accepted, so the production callback is
# rejected. This is NOT an SWP_* name - the app reads AUTH_CALLBACK_ALLOWLIST.
AUTH_CALLBACK_ALLOWLIST=

# POSCO SWP settings. Values must match the production SWP registration.
SWP_SSO_LOGIN_URL=
SWP_SSO_VALID_CHECK_URL=
SWP_SSO_REDIRECT_URL=

# Column positions in the CSV that isValidSSO.jsp returns, zero based.
# These are NOT credentials - they are the field order of that response, and
# they decide which column becomes the employee number that identifies a user.
# Leave them empty and the defaults below are used; if the real field order
# differs, the app reads the wrong column and assigns the wrong identity
# WITHOUT any error. Confirm the order on the first live call before relying
# on the defaults (set SWP_SSO_LOG_RAW=1 once to print the raw response).
SWP_IDX_ID=0
SWP_IDX_EMPNO=1
SWP_IDX_DISPLAYNAME=8
SWP_IDX_MAIL=9
SWP_IDX_DEPT=4

# Used when the CSV carries no mail address.
SWP_EMAIL_FALLBACK_DOMAIN=posco.local

# Seconds to wait for isValidSSO.jsp. Optional; the default is 15.
SWP_SSO_TIMEOUT_S=15
