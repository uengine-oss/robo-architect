# Robo Architect 서버 배포(posco-web) — compose 가 읽는 값 **전부**.
#
#   cp .env.example .env && chmod 600 .env && vi .env
#
# 이 파일의 값은 compose 의 `environment:` 로만 컨테이너에 들어간다.
# 완성된 .env 는 Git·메일·메신저로 보내지 않는다.
#
# 비밀 값은 영문·숫자만 쓴다(DSN 안에 들어가므로 @ : / # 는 안 된다). 만드는 법:
#     openssl rand -hex 24
#
# 분할 배포(AP·DB 두 대)면 **두 서버의 .env 가 같은 값**을 가져야 한다 —
# 한 파일을 만들어 두 서버에 똑같이 놓는다. 한쪽만 다르면 AP 가 DB 에 인증 실패한다.

# ── [고치는 곳] 사람이 정하는 값 ──────────────────────────────────────────

# 브라우저가 여는 주소(scheme://host:port). SWP 콜백이 이 origin 으로만 돌아온다.
# 비우면 loopback 만 허용되어 서버 주소의 로그인이 **거부된다.**
ROBO_PUBLIC_URL=http://CHANGE_ME_AP_SERVER_IP:8080

# 최초 관리자 사번(SWP 의 sp_empno). 이 사람이 다른 사람의 가입을 승인한다.
ROBO_ADMIN_EMPNO=CHANGE_ME

# 사내 AI 게이트웨이(P-GPT). 납품본 config/*.env 의 OPENAI_BASE_URL 과 같은 값이다.
ROBO_AI_BASE_URL=http://CHANGE_ME_PGPT_HOST/v1
ROBO_AI_API_KEY=CHANGE_ME
# analyzer(레거시 분석)가 쓸 모델 설정 — 위 주소와 **짝을 맞춘다**.
#   pgpt          사내 P-GPT (ROBO_AI_BASE_URL 이 P-GPT 일 때)
#   openai_gpt41  OpenAI 직결 (ROBO_AI_BASE_URL=https://api.openai.com/v1 일 때)
# analyzer 는 주소를 이 설정 파일에서만 읽는다 — 위 주소만 바꾸면 분석만 P-GPT 로 간다.
ROBO_ANALYZER_LLM_CONFIG=pgpt

# SWP 주소 — 비우면 코드 기본값(가동계)을 쓴다. 개발계로 붙을 때만 채운다.
SWP_SSO_LOGIN_URL=
SWP_SSO_VALID_CHECK_URL=
SWP_SSO_REDIRECT_URL=

# 새로 들어온 사람을 관리자가 승인해야 쓰게 하나(true) · 바로 쓰게 하나(false).
# robo-central.sh 의 APPROVAL_REQUIRED 와 같은 뜻이다. authority-init 이 돌 때 반영된다.
ROBO_APPROVAL_REQUIRED=true

# ── [만들어 넣는 값] openssl rand -hex 24 — 한 번 정하면 바꾸지 않는다 ─────

# 그래프 저장소 소유자 비밀번호. ⚠ 볼륨을 처음 만들 때 정해진다 — 나중에 바꾸면
#   DB 안의 role 은 그대로라 **전부 인증 실패**한다.
ROBO_GRAPH_PASSWORD=CHANGE_ME
# 권한 서버의 제한된 DB 역할(robo_authority — authority-init 이 만든다).
ROBO_AUTHORITY_DB_PASSWORD=CHANGE_ME
# 로그인 토큰 서명 · 사용자 DB role 비밀번호 유도. 32자 이상, 서로 달라야 한다.
AUTH_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
AUTH_ROLE_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
# Architect ↔ pdf2bpmn 사이의 공유 시크릿. 모델 키를 재사용하지 않는다.
PDF2BPMN_FACADE_KEY=CHANGE_ME

# ── 고정값 — 납품본 매니페스트(graphs)와 같다. 바꾸지 않는다 ───────────────

ROBO_GRAPH_USER=robo
ROBO_GRAPH_DESIGN=robo
# 설계 graph 와 **달라야 한다**(같으면 graph-db 가 초기화를 거부한다 — 분석이 설계를 지운다).
ROBO_GRAPH_ANALYSIS=analyzer_run

# ── 포트·바인드 ───────────────────────────────────────────────────────────

# 브라우저 진입점. 통합 서버·AP 서버에서 쓴다.
ROBO_WEB_BIND=0.0.0.0
ROBO_WEB_PORT=8080

# 분할 배포에서만 쓴다.
#   AP 서버: DB 서버의 사내망 IP
#   DB 서버: 공개할 자기 사내망 IP(0.0.0.0 금지 — Bolt 는 평문 인증이다)
ROBO_DB_SERVER_IP=CHANGE_ME_DB_SERVER_IP
ROBO_DB_PG_PORT=5432
ROBO_DB_BOLT_PORT=7687
ROBO_AUTHORITY_PORT=59020
